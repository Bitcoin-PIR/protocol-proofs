{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bitcoin-PIR/protocol-proofs/blob/main/schema/proof-manifest.schema.json",
  "title": "BitcoinPIR protocol proof manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_suite",
    "title",
    "origin",
    "implementation_binding",
    "model",
    "expected_lemma_count",
    "axioms",
    "claims",
    "assumptions",
    "explicit_non_claims",
    "toolchain",
    "verification",
    "sources"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "proof_suite": { "const": "bitcoinpir-wire-shape-simulator" },
    "title": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "source_content_commit"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 },
        "source_content_commit": { "$ref": "#/$defs/sha1" }
      }
    },
    "implementation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repository", "contract_schema", "contract_path", "wire_contract_sha256", "generated_source", "explanation", "required_consumer_lock_fields"],
      "properties": {
        "status": { "enum": ["not-mechanized", "contract-hash-bound"] },
        "repository": { "type": "string", "format": "uri" },
        "contract_schema": { "type": "string", "minLength": 1 },
        "contract_path": { "type": "string", "minLength": 1 },
        "wire_contract_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "generated_source": { "const": "ContractBinding.ec" },
        "explanation": { "type": "string", "minLength": 1 },
        "required_consumer_lock_fields": {
          "const": [
            "protocolProofs.commit",
            "protocolProofs.manifestSha256",
            "implementationContract.sha256",
            "protocolProofs.verificationRecordSha256"
          ]
        }
      }
    },
    "model": { "type": "object" },
    "expected_lemma_count": { "type": "integer", "minimum": 1 },
    "axioms": {
      "type": "array",
      "items": { "$ref": "#/$defs/axiom" },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assumption" }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonClaim" }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerfile", "base_image", "platform", "easycrypt_repository", "easycrypt_commit", "ocaml_version", "why3_version", "solvers"],
      "properties": {
        "dockerfile": { "type": "string", "minLength": 1 },
        "base_image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
        "platform": { "type": "string", "minLength": 1 },
        "easycrypt_repository": { "type": "string", "format": "uri" },
        "easycrypt_commit": { "$ref": "#/$defs/sha1" },
        "ocaml_version": { "type": "string", "minLength": 1 },
        "why3_version": { "type": "string", "minLength": 1 },
        "solvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "top_level", "ci_workflow", "success_condition", "evidence_artifact"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "top_level": { "type": "string", "minLength": 1 },
        "ci_workflow": { "type": "string", "minLength": 1 },
        "success_condition": { "type": "string", "minLength": 1 },
        "evidence_artifact": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "theorem", "status", "scope", "depends_on_assumptions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "theorem": { "type": "string", "minLength": 1 },
        "status": { "const": "mechanically-checked" },
        "scope": { "type": "string", "minLength": 1 },
        "depends_on_assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "axiom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "statement_sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "source": { "type": "string", "pattern": "^[^/]+\\.ec$" },
        "statement_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "source_locations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source_locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/]+\\.ec$" },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
