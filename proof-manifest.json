  "proof_suite": "bitcoinpir-wire-shape-simulator",
  "title": "BitcoinPIR PIR and Payment V1 wire-shape simulator property",
  "origin": {
    "repository": "https://github.com/Bitcoin-PIR/Bitcoin-PIR",
    "path": "proofs/easycrypt",
    "source_content_commit": "74f2f5b20c90c301bc78fd4298f435983e13950a"
  },
  "implementation_binding": {
    "status": "contract-hash-bound",
    "repository": "https://github.com/Bitcoin-PIR/Bitcoin-PIR",
    "contract_schema": "BitcoinPIR/wire-shape-contract/v1",
    "contract_path": "verification/contracts/wire-shape-v1.json",
    "wire_contract_sha256": "648227ffba4946b5adc55291bdb77eb452d93a5c03c553a17dc6f5d053b97bf7",
    "generated_source": "ContractBinding.ec",
    "explanation": "The product repository deterministically generates ContractBinding.ec from the named wire contract and requires it in the compiled proof closure. This binds public parameters, formal PIR server ids, Payment V1 authorization constants, round-kind coverage, and the per-server leakage projection to the contract; product-side compiled Rust tests separately bind the canonical padding and secure-channel record dimensions. It is not a full refinement proof from Rust or TypeScript to EasyCrypt.",
    "required_consumer_lock_fields": [
      "protocolProofs.commit",
      "protocolProofs.manifestSha256",
      "implementationContract.sha256",
      "protocolProofs.verificationRecordSha256"
    ]
  },
  "model": {
    "observation": "Ordered provider-visible PIR and Payment V1 authorization transcript for one query or a sequence of queries; the authorization request byte count is also the no-channel-key network-observer projection",
    "fields": [
      "round_kind",
      "server_id",
      "database_id",
      "request_bytes",
      "response_bytes",
      "item_counts",
      "authorization_scheme",
      "service_scope_id",
      "authorization_operation",
      "authorization_timing",
      "authorization_result_shape"
    ],
    "observer_boundaries": {
      "network_without_channel_keys": {
        "fixed_request_application_record_bytes": 16414,
        "request_shape_hides": [
          "authorization_scheme",
          "service_scope_id",
          "authorization_operation",
          "credential_proof_length"
        ],
        "admitted_leakage": [
          "authorization_occurrence_and_timing",
          "authorization_result_shape"
        ]
      },
      "provider_after_channel_decryption": {
        "necessarily_visible": [
          "authorization_scheme",
          "service_scope_id",
          "authorization_operation",
          "credential_presentation",
          "authorization_timing",
          "authorization_result"
        ]
      }
    },
    "backends": [
      "dpf",
      "harmonypir",
      "onionpir"
    ],
    "public_parameters": {
      "index_groups": 75,
      "chunk_groups": 80,
      "index_cuckoo_hashes": 2
    },
    "admitted_leakage": [
      "index_max_items_per_group_per_level",
      "chunk_max_items_per_group_per_level",
      "session_query_index",
      "query_db_id",
      "authorization_scheme_by_server",
      "authorization_scope_id_by_server",
      "authorization_operation_by_server",
      "authorization_timing_by_server",
      "authorization_result_shape_by_server"
    ]
  },
